# =============================================================================
# Persona — Environment Variable Template
# =============================================================================
# Copy this file to ".env" (in the same folder) and fill in your real values.
# Never commit your actual ".env" file to version control!
#
#   cp .env.example .env
#
# =============================================================================

# Your Groq API Key.
# Get one for free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Optional settings below — safe to leave as defaults.
# -----------------------------------------------------------------------------

# Primary model the LLM Engine calls for everyday chat.
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Fast fallback model, used automatically if the primary model is rate
# limited or unavailable.
GROQ_FALLBACK_MODEL_NAME=llama-3.1-8b-instant

# Reasoning-heavy model, available for future use on prompts that benefit
# from an explicit chain-of-thought style model.
GROQ_REASONING_MODEL_NAME=deepseek-r1-distill-llama-70b

# App display name shown in the browser tab / header.
APP_DISPLAY_NAME=Persona Agentic Assistant
